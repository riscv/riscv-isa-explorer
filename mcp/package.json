  "homepage": "https://tech.riscv.org/isa-explorer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riscv/riscv-isa-explorer.git",
    "directory": "mcp"
  },
  "bugs": "https://github.com/riscv/riscv-isa-explorer/issues",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  }
