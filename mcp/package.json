{
  "name": "@riscv/isa-explorer-mcp",
  "version": "0.1.0",
  "description": "MCP server for the RISC-V ISA Explorer: extensions, dependencies, -march strings, profiles and instruction encodings for LLM clients",
  "type": "module",
  "bin": {
    "riscv-isa-explorer-mcp": "bin/riscv-isa-explorer-mcp.mjs"
  },
  "files": [
